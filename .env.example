# Supabase Postgres connection string — use the DIRECT connection (port 5432),
# not the pooled/pgbouncer one (port 6543): Prisma's pg driver adapter uses
# real prepared statements, which aren't compatible with pgbouncer transaction
# pooling. Settings > Database > Connection string > URI > "Direct connection".
DATABASE_URL=

# Base URL used to build share links (e.g. http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=
